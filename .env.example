# ============================================================
# LANDSLIDE SENTINEL AI — ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and configure the appropriate values.
# NEVER commit .env to version control.

# ------------------------------------------------------------
# System Environment
# ------------------------------------------------------------
NODE_ENV=development
PORT=3000
DATA_MODE=LIVE  # Options: LIVE, HISTORICAL, SIMULATION, DEMO

# ------------------------------------------------------------
# AI Services & Computer Vision
# ------------------------------------------------------------
# Google Gemini API Key for multimodal field image geotechnical analysis
GEMINI_API_KEY=

# ------------------------------------------------------------
# NASA Earthdata & Precipitation Processing
# ------------------------------------------------------------
# NASA Precipitation Processing System (PPS) FTP/HTTPS credentials
NASA_PPS_EMAIL=
NASA_PPS_PASSWORD=

# ------------------------------------------------------------
# Enterprise Database (PostGIS)
# ------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/landslide_sentinel_db
DB_SSL=false

# ------------------------------------------------------------
# Alerting & Emergency Webhooks
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
